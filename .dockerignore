**

!package.json
!.npmignore
!bun.lock
!tsconfig.json

# The manifest stage needs Git's tracked-file INVENTORY and nothing else: `git ls-files` reads
# the index and never opens an object or a ref. Admitting those two files costs about 1 MB;
# admitting .git wholesale would put 1.3 GB in every local build context. The stage supplies the
# empty objects/ and refs/ directories Git's repository check insists on, in a scratch GIT_DIR.
# No COPY includes either file, so neither reaches an image layer.
!.git/
.git/**
!.git/index
!.git/HEAD

!src/
!src/**
# Optional compatibility path for hosts that already generated the canonical artifact.
!src/generated/compatibility-version.json

!scripts/
scripts/**
!scripts/model-metadata.source.json
!scripts/generate-compatibility-version.ts

!docker/
!docker/**

!gui/
!gui/**
gui/node_modules/
gui/dist/
gui/.vite/

# npm package inputs not needed by the application image build. Keep this list
# aligned with package.json's files allowlist.
!bin/
!bin/**
!assets/
!assets/banner.png
!assets/architecture.png
!assets/claude-code-models.gif
!assets/codex-app-picker.png
!assets/sponsors/
!assets/sponsors/orcarouter.png
!assets/sponsors/tokenlab-light.png
!assets/sponsors/tokenlab-dark.png
!README.md
!SPONSORS.md
!AGENTS_INSTALL.md
!LICENSE
!native/
!native/remote-workspace-helper/
!native/remote-workspace-helper/Cargo.toml
!native/remote-workspace-helper/Cargo.lock
!native/remote-workspace-helper/src/
!native/remote-workspace-helper/src/**
!native/ocx-child/
!native/ocx-child/Cargo.toml
!native/ocx-child/Cargo.lock
!native/ocx-child/src/
!native/ocx-child/src/**

**/*.log
